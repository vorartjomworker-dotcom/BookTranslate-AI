APP_DOMAIN=translate.example.com
MAX_UPLOAD_SIZE_MB=100

POSTGRES_DB=booktranslate
POSTGRES_USER=booktranslate

S3_BUCKET=booktranslate
S3_REGION=us-east-1
MINIO_ROOT_USER=booktranslate-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

SESSION_ACCESS_TTL_SECONDS=28800
SESSION_REFRESH_TTL_SECONDS=2592000
SESSION_MAX_ACTIVE_PER_USER=20

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=booktranslate_role
OIDC_DEFAULT_ROLE=viewer

SCIM_ENABLED=false
SCIM_DEFAULT_ROLE=viewer
SCIM_ROLE_GROUP_PREFIX=BookTranslate-

OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
PROVIDER_FEEDBACK_TTL_SECONDS=300
PROVIDER_COOLDOWN_DEFAULT_SECONDS=60
PROVIDER_MIN_REMAINING_REQUESTS=1
VISION_PROVIDER=openai
VISION_MODEL=

FIGURE_RENDER_DEFAULT_MODE=inpaint
FIGURE_INPAINT_RADIUS_PX=3
FIGURE_VECTOR_SVG_ENABLED=true

AI_REQUEST_TIMEOUT_SECONDS=120
TRANSLATION_WORKER_POLL_SECONDS=5
TRANSLATION_JOB_RECOVERY_AGE_SECONDS=900
VISION_WORKER_POLL_SECONDS=5
VISION_JOB_RECOVERY_AGE_SECONDS=900
FIGURE_RENDER_WORKER_POLL_SECONDS=5
FIGURE_RENDER_JOB_RECOVERY_AGE_SECONDS=900
WORKER_LEASE_SECONDS=180
WORKER_LEASE_RENEW_SECONDS=45

DOWNLOAD_TICKET_TTL_SECONDS=120
STORAGE_PRESIGN_TTL_SECONDS=120
SLO_AVAILABILITY_TARGET=0.995
SLO_P95_LATENCY_SECONDS=1.0
PROMETHEUS_RETENTION=30d

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
