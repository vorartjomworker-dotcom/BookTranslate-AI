# BookTranslate AI
POSTGRES_DB=booktranslate
POSTGRES_USER=booktranslate
POSTGRES_PASSWORD=booktranslate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100
APP_ENVIRONMENT=development

# Storage: local | s3 | minio
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=booktranslate
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ACCESS_KEY_FILE=
S3_SECRET_KEY_FILE=
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
# Enable only when generated S3 URLs are directly reachable by end-user browsers.
S3_PRESIGN_DOWNLOADS=false
STORAGE_PRESIGN_TTL_SECONDS=120
MINIO_ROOT_USER=booktranslate
MINIO_ROOT_PASSWORD=minio-dev-only-change-me

# Local development can keep auth disabled. Production should enable it.
AUTH_REQUIRED=false
BOOTSTRAP_ADMIN_TOKEN=
BOOTSTRAP_ADMIN_TOKEN_FILE=
AUTH_SIGNING_SECRET=
AUTH_SIGNING_SECRET_FILE=
DOWNLOAD_TICKET_TTL_SECONDS=120
CORS_ORIGINS=http://localhost:3000

# Generic OpenID Connect / SSO
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=booktranslate_role
OIDC_DEFAULT_ROLE=viewer

AI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_API_KEY_FILE=
KIMI_BASE_URL=https://api.moonshot.ai/v1
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AITUNNEL_API_KEY=
AITUNNEL_API_KEY_FILE=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Vision/OCR. Model is intentionally deployment-configured rather than hard-coded.
VISION_PROVIDER=openai
VISION_MODEL=
VISION_QUEUE_NAME=vision
VISION_WORKER_POLL_SECONDS=5
VISION_JOB_RECOVERY_AGE_SECONDS=900

# Figure translation redraw
FIGURE_RENDER_QUEUE_NAME=figure-render
FIGURE_RENDER_WORKER_POLL_SECONDS=5
FIGURE_RENDER_JOB_RECOVERY_AGE_SECONDS=900
FIGURE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FIGURE_RENDER_MIN_FONT_SIZE=8
FIGURE_RENDER_MAX_FONT_SIZE=48
FIGURE_RENDER_PADDING_PX=2

TRANSLATION_QUEUE_NAME=translation
TRANSLATION_WORKER_POLL_SECONDS=5
TRANSLATION_JOB_RECOVERY_AGE_SECONDS=900

# Distributed worker leases
WORKER_LEASE_SECONDS=180
WORKER_LEASE_RENEW_SECONDS=45

# Prometheus + OpenTelemetry
METRICS_TOKEN=
METRICS_TOKEN_FILE=
AUDIT_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=booktranslate-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
SLO_AVAILABILITY_TARGET=0.995
SLO_P95_LATENCY_SECONDS=1.0

NEXT_PUBLIC_API_URL=http://localhost:8000
