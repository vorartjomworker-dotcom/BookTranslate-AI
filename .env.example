# BookTranslate AI
POSTGRES_DB=booktranslate
POSTGRES_USER=booktranslate
POSTGRES_PASSWORD=booktranslate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# Local development remains backwards-compatible with auth disabled.
# Production should set AUTH_REQUIRED=true and a strong one-time bootstrap secret.
AUTH_REQUIRED=false
BOOTSTRAP_ADMIN_TOKEN=

AI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

TRANSLATION_QUEUE_NAME=translation
TRANSLATION_WORKER_POLL_SECONDS=5
TRANSLATION_JOB_RECOVERY_AGE_SECONDS=900

NEXT_PUBLIC_API_URL=http://localhost:8000
