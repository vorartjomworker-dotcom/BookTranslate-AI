# BookTranslate AI
POSTGRES_DB=booktranslate
POSTGRES_USER=booktranslate
POSTGRES_PASSWORD=booktranslate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# Local development can keep auth disabled. Production should enable it.
AUTH_REQUIRED=false
BOOTSTRAP_ADMIN_TOKEN=
AUTH_SIGNING_SECRET=
DOWNLOAD_TICKET_TTL_SECONDS=120
CORS_ORIGINS=http://localhost:3000

# Generic OpenID Connect / SSO
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=booktranslate_role
OIDC_DEFAULT_ROLE=viewer

AI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Vision/OCR. Model is intentionally deployment-configured rather than hard-coded.
VISION_PROVIDER=openai
VISION_MODEL=
VISION_QUEUE_NAME=vision
VISION_WORKER_POLL_SECONDS=5
VISION_JOB_RECOVERY_AGE_SECONDS=900

TRANSLATION_QUEUE_NAME=translation
TRANSLATION_WORKER_POLL_SECONDS=5
TRANSLATION_JOB_RECOVERY_AGE_SECONDS=900

# Prometheus endpoint /metrics. Required when AUTH_REQUIRED=true.
METRICS_TOKEN=
AUDIT_ENABLED=true

NEXT_PUBLIC_API_URL=http://localhost:8000
